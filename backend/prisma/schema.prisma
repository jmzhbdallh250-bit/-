datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  phone          String?  @unique
  passwordHash   String?
  displayName    String?
  avatarUrl      String?
  isGuest        Boolean  @default(false)
  createdAt      DateTime @default(now())
  matchesPlayed  Int      @default(0)
  goals          Int      @default(0)
  rating         Float?
  awards         String[] @default([])
  playerCard     PlayerCard?
  bookings       Booking[]
  posts          MercatoPost[]
}

model PlayerCard {
  id          String  @id @default(uuid())
  user        User    @relation(fields: [userId], references: [id])
  userId      String  @unique
  stamina     Int     @default(50)
  speed       Int     @default(50)
  technique   Int     @default(50)
  positionPref String?
  createdAt   DateTime @default(now())
}

model Venue {
  id          String   @id @default(uuid())
  name        String
  area        String
  type        VenueType
  images      String[]  @default([])
  capacity    Int
  turfType    String
  isAvailable Boolean  @default(true)
  lat         Float?
  lng         Float?
  createdAt   DateTime @default(now())
  bookings    Booking[]
  description String?
}

enum VenueType {
  FIVE
  SEVEN
  ELEVEN
}

model Booking {
  id        String  @id @default(uuid())
  venue     Venue   @relation(fields: [venueId], references: [id])
  venueId   String
  startTime DateTime
  endTime   DateTime
  createdBy User    @relation(fields: [createdById], references: [id])
  createdById String
  status    BookingStatus @default(CONFIRMED)
  match     Match?
}

enum BookingStatus {
  CONFIRMED
  PENDING
  CANCELLED
}

model Match {
  id           String   @id @default(uuid())
  title        String
  venue        Venue?   @relation(fields: [venueId], references: [id])
  venueId      String?
  type         MatchType
  formation    String
  scheduledAt  DateTime
  creator      User     @relation(fields: [creatorId], references: [id])
  creatorId    String
  players      MatchPlayer[]
  createdAt    DateTime @default(now())
}

enum MatchType {
  FIVE
  SEVEN
  ELEVEN
}

model MatchPlayer {
  id        String @id @default(uuid())
  match     Match  @relation(fields: [matchId], references: [id])
  matchId   String
  user      User?  @relation(fields: [userId], references: [id])
  userId    String?
  position  String?
  slotIndex Int
}

model MercatoPost {
  id        String   @id @default(uuid())
  teamName  String
  needed    String[] 
  message   String?
  contactId String?
  createdBy User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt DateTime @default(now())
}
